{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "baseUrl": ".",
    "typeRoots": ["./types", "./node_modules/@types"],
    "downlevelIteration": true
  },
  "include": ["scripts/**/*.ts", "types/**/*.d.ts", "n8n-integration/**/*.ts"]
}
